% 1. Remove os parênteses das URLs
\DeclareRobustCommand{\url}[1]{#1}

% 2. Define os prefixos apenas se eles já existirem, evitando o erro "Undefined"
\providecommand{\URLdisponivel}{Disponível em: }
\providecommand{\URLacesso}{Acesso em: }

% 3. Ajusta a fonte da URL para ser igual à do texto
\urlstyle{same}

