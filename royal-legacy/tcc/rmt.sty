%%%%%%%%%%%%%%%%%
% Parâmetros do pacote
%%%%%%%%%%%%%%%%%

\DeclareOption{apresentacao}{
	\setbeamertemplate{caption}[numbered]
}

\DeclareOption{impressao}{
	\pgfpagesuselayout{4 on 1}[a4paper,border shrink=5mm,landscape]
}

\ProcessOptions\relax
\let\Tiny=\tiny

%%%%%%%%%%%%%%%%%
% Definições de cores e Estilos de Código
%%%%%%%%%%%%%%%%%

\definecolor{tcCinza}{rgb}{0.960000,0.960000,0.960000}
\definecolor{mygreen}{RGB}{28,172,0}
\definecolor{mylilas}{RGB}{170,55,241}

% Tradução dos termos do pacote listings para o Português (ABNT)
\renewcommand{\lstlistingname}{Código}
\renewcommand{\lstlistlistingname}{Sumário de Códigos}

\lstset{
    tabsize=4,
    breaklines=true,
    keywordstyle=\color{blue}\bfseries,
    stringstyle=\color{mylilas},
    commentstyle=\color{mygreen},
    showstringspaces=false,
    numbers=left,
    numberstyle={\tiny \color{black}},
    inputencoding=utf8,               % Atualizado para o padrão moderno UTF-8
    extendedchars=true,
    frame=single,                     % Moldura elegante ao redor do código
    captionpos=t,                      % Legenda sempre no topo (Padrão ABNT)
    % Mapeamento de acentos caso você precise usar comentários em português no futuro
    literate={á}{{\'a}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1 {é}{{\'e}}1 {ã}{{\~a}}1 {õ}{{\~o}}1 {ç}{{\c{c}}}1 {Í}{{\'I}}1 {É}{{\'E}}1 {Á}{{\'A}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
}

\lstdefinestyle{CodigoFonte}{
	numbers=left, xleftmargin=5mm, frame=trBL, frameround=fttf
}

%%%%%%%%%%%%%%%%%%
% Novos comandos (Figuras e Tabelas)
%%%%%%%%%%%%%%%%%%

\newcommand{\figura}[4]{
  \begin{figure}[H]
    \centering	
    \ifx &#3& \else \caption{#3} \label{#4} \fi
    \includegraphics[width=#2]{#1}    
  \end{figure}
}

% Comandos para Requisitos e Casos de Uso (Preservados do Original)
\def\larguraTabelaRequisitos#1{\def\@larguraTabelaRequisitos{#1}} \larguraTabelaRequisitos{10cm}
\def\larguraTabela#1{\def\@larguraTabela{#1}} \larguraTabela{15.5cm}

\newcommand{\requisito}[9]{
	\begin{center}
	\begin{longtable}[H]{|l|p{\@larguraTabelaRequisitos}|}
		\caption{Requisito Funcional (#1): #2.} \label{#7}\\ \hline
		\multicolumn{1}{|>{\columncolor{tcCinza}}l|}{Identificação} & \textbf{#1}\\ \hline
		\multicolumn{1}{|>{\columncolor{tcCinza}}l|}{Nome} & #2\\ \hline
		\multicolumn{1}{|>{\columncolor{tcCinza}}l|}{Fonte} & #3\\ \hline
		\multicolumn{1}{|>{\columncolor{tcCinza}}l|}{Data} & #4\\ \hline
		\multicolumn{2}{|>{\columncolor{tcCinza}}c|}{Especificação} \\ \hline
		\multicolumn{2}{|p{\@larguraTabela}|}{#9} \\ \hline
	\end{longtable}
	\end{center}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Configurações para tabelas (Alinhamentos Especiais)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcolumntype{L}[1]{>{\raggedright\let\newline\\\arraybackslash\hspace{0pt}}m{#1}}
\newcolumntype{C}[1]{>{\centering\let\newline\\\arraybackslash\hspace{0pt}}m{#1}}
\newcolumntype{R}[1]{>{\raggedleft\let\newline\\\arraybackslash\hspace{0pt}}m{#1}}

